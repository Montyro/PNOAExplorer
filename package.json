{
  "name": "pnoa-explorer",
  "version": "0.1.0",
  "description": "Visor web local de PNOA LiDAR y ortofoto con LOD y mapas de elevación.",
  "repository": "https://github.com/Montyro/PNOAExplorer.git",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:navigation": "node scripts/navigation.mjs",
    "release:win": "npm run build && bun scripts/build-release.ts",
    "test:release": "node scripts/release-smoke.mjs",
    "capture:demo": "node scripts/capture-demo.mjs"
  },
  "dependencies": {
    "copc": "^0.0.7",
    "ol": "^10.6.1",
    "proj4": "^2.19.10"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
